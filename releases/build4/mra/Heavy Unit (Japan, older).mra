<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Heavy Unit (Japan, older)</name>
    <setname>hvyunitjo</setname>
    <mameversion>0289</mameversion>
    <year>1988</year>
    <manufacturer>Kaneko / Taito</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>heavyunit</rbf>
    <region>Japan</region>

    <!--
      Flat image for the Heavy Unit core (target/mister/hvyunit_mem.sv), 0x2C1000 bytes:

        0x000000  0x020000  main Z80 program (8 banks of 16 KB)
        0x020000  0x010000  sub  Z80 program (4 banks)
        0x030000  0x010000  sound Z80 program (4 banks)
        0x040000  0x080000  background tiles, 16x16 4bpp
        0x0C0000  0x200000  Pandora sprites, 16x16 4bpp (gaps are zero, as MAME's ROMREGION_ERASE00)
        0x2C0000  0x001000  Mermaid 8751 firmware (0x0E00 bytes, zero padded)

      Generated by tools/gen_hvyunit_mra.py from tools/hvyunit_roms.py. Expects the MAME 0.289
      merged romset (hvyunit.zip) or the split sets; parts are found by name or CRC, whatever
      folder holds them.
    -->
    <rom index="0" zip="hvyunitjo.zip|hvyunit.zip" md5="None" address="0x32000000">
        <part name="b73_13.5c" crc="e2874601"/>
        <part name="b73_14.5p" crc="0dfb51d4"/>
        <part name="b73_12.7e" crc="d1d24fab"/>
        <part name="b73_09.2p" crc="537c647f"/>
        <part name="b73_08.2f" crc="f83dd808"/>
        <part repeat="0x80000">00</part>
        <part name="b73_07.2c" crc="5cffa42c"/>
        <part repeat="0x10000">00</part>
        <part name="b73_06.2b" crc="a98e4aea"/>
        <part repeat="0x10000">00</part>
        <part name="b73_01.1b" crc="3a8a4489"/>
        <part repeat="0x10000">00</part>
        <part name="b73_02.1c" crc="025c536c"/>
        <part repeat="0x10000">00</part>
        <part name="b73_03.1d" crc="ec6020cf"/>
        <part repeat="0x10000">00</part>
        <part name="b73_04.1f" crc="f7badbb2"/>
        <part repeat="0x10000">00</part>
        <part name="b73_05.1h" crc="b8e829d2"/>
        <part repeat="0x30000">00</part>
        <part name="mermaid.bin" crc="88c5dd27"/>
        <part repeat="0x200">00</part>
    </rom>

    <switches default="FE,F7" base="16">
        <dip name="Cabinet" bits="0" ids="Upright,Cocktail"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Coin A" bits="4,5" ids="2C/3C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Coin B" bits="6,7" ids="2C/3C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Allow Continue" bits="10" ids="Off,On"/>
        <dip name="Bonus" bits="11" ids="On,Off"/>
        <dip name="Lives" bits="12,13" ids="7,5,4,3"/>
        <dip name="Demo Sounds" bits="14" ids="Off,On"/>
    </switches>

    <buttons names="Fire,Bomb,Start 1P,Start 2P,Coin" default="A,B,Start,Select,R"/>
</misterromdescription>
