+
+// hvyunit-mister: port write strobes.  MAME's i8051 calls its port-out
+// callback on EVERY write to P0..P3, even of an unchanged value, and the Heavy
+// Unit glue depends on that.  This pulse is coincident with the latch update
+// above, so p*_o already shows the new value when it is high.
+always @(posedge clk) begin
+    if (rst) port_we <= 4'd0;
+    else begin
+        port_we <= 4'd0;
+        if (cen && sfr_we) case (sfr_addr)
+            8'h80: port_we[0] <= 1'b1;
+            8'h90: port_we[1] <= 1'b1;
+            8'ha0: port_we[2] <= 1'b1;
+            8'hb0: port_we[3] <= 1'b1;
+            default: ;
+        endcase
+    end
 end
 
